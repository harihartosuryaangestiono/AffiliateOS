# Explicitly choose demo or production. Production never falls back to browser demo data.
AFFILIATEOS_MODE=demo

# Use the publishable key naming supported by your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Existing server-only aliases remain supported for deployments that already use them.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Never expose or commit SUPABASE_SERVICE_ROLE_KEY.

# Google Gemini API Copilot (Server-side only — never expose to client or NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
